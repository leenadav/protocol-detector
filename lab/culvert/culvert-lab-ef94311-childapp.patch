@@ -0,0 +1,40 @@
+package protodetect
+
+import (
+	"github.com/leenadav/protocol-detector/go/detector"
+)
+
+// RealApps wraps detector.AppClassifier. Like real.go, it is the only place that names the library's API.
+type RealApps struct{ c *detector.AppClassifier }
+
+var _ AppClassifier = (*RealApps)(nil)
+
+// NewRealApps builds the classifier from the content data built into the library. Zero limits take the
+// library's defaults (64 rule evaluations, 4,096 path bytes).
+func NewRealApps(maxRuleEvaluations, maxPathBytes int) (*RealApps, error) {
+	c, err := detector.NewAppClassifier(detector.AppLimitsConfig{MaxRuleEvaluations: maxRuleEvaluations, MaxPathBytes: maxPathBytes})
+	if err != nil {
+		return nil, err
+	}
+	return &RealApps{c: c}, nil
+}
+
+// Classify never panics: the library recovers its own, and this is the second layer.
+func (r *RealApps) Classify(q AppRequest) (v AppVerdict) {
+	defer func() {
+		if recover() != nil {
+			v = AppVerdict{Basis: "none", Reasons: []string{"panic"}}
+		}
+	}()
+	d := r.c.Classify(detector.HTTPRequest{SNI: q.SNI, Host: q.Host, Method: q.Method, Path: q.Path,
+		ContentType: q.ContentType, RequestBodyBytes: q.RequestBodyBytes, ResponseBodyBytes: -1,
+		WebSocket: q.WebSocket, HeaderNames: q.HeaderNames})
+	return AppVerdict{App: d.App, Container: d.Container, Basis: d.Basis, Limit: d.Limit, Reasons: d.Reasons,
+		ChildRelease: d.ChildRelease, PackRelease: d.PackRelease}
+}
+
+// LibraryAppVocab returns the library's closed vocabularies (bases, reasons, limits), for the test that
+// keeps internal/pdobs exhaustive.
+func LibraryAppVocab() (bases, reasons, limits []string) {
+	return detector.AppBases(), detector.AppReasons(), detector.AppLimits()
+}
