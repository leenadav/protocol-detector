+package main
+
+// LAB ONLY (PRO-504): child applications on the decrypted-request path, with the real detector library.
+
+import (
+	"bufio"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"math/big"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+
+	"github.com/KidCarmi/Culvert/internal/pdobs"
+	"github.com/KidCarmi/Culvert/internal/protodetect"
+)
+
+// withLabApps installs a classifier (nil: off) for one test and restores the previous one.
+func withLabApps(t *testing.T, c protodetect.AppClassifier) {
+	t.Helper()
+	labAppsCls() // settle the Once first, so it never overwrites the test's value
+	prev := labAppsClassifier
+	labAppsClassifier = c
+	t.Cleanup(func() { labAppsClassifier = prev })
+}
+
+func realApps(t testing.TB, maxRules, maxPath int) protodetect.AppClassifier {
+	t.Helper()
+	c, err := protodetect.NewRealApps(maxRules, maxPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+// innerReq builds a decrypted request as http.ReadRequest leaves it (RequestURI is the raw target).
+func innerReq(t testing.TB, method, host, target, contentType string, body int64) *http.Request {
+	t.Helper()
+	raw := fmt.Sprintf("%s %s HTTP/1.1\r\nHost: %s\r\n", method, target, host)
+	if contentType != "" {
+		raw += "Content-Type: " + contentType + "\r\n"
+	}
+	if body >= 0 {
+		raw += fmt.Sprintf("Content-Length: %d\r\n", body)
+	}
+	raw += "\r\n" + strings.Repeat("x", int(max(body, 0)))
+	req, err := http.ReadRequest(bufio.NewReader(strings.NewReader(raw)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return req
+}
+
+const gmailUploadPath = "/upload/gmail/v1/users/me/messages?uploadType=media"
+
+// TestLabChildAppVerdicts is the task's four cases through the tally, with the real classifier.
+func TestLabChildAppVerdicts(t *testing.T) {
+	std := realApps(t, 0, 0)
+	cases := []struct {
+		name                   string
+		cls                    protodetect.AppClassifier
+		sni, host, path, ctype string
+		wantApp, wantContainer string
+		wantBasis, wantLimit   string
+		wantReason             string
+	}{
+		{"gmail upload is the child", std, "gmail.googleapis.com", "gmail.googleapis.com", gmailUploadPath, "message/rfc822",
+			"gmail-uploading", "gmail", pdobs.BasisRequestRule, "", pdobs.ReasonChildMatched},
+		{"unowned host has no app", std, "unowned.example", "unowned.example", "/upload", "message/rfc822",
+			"", "", pdobs.BasisNone, "", pdobs.ReasonHostUnowned},
+		{"non-canonical path has no child", std, "gmail.googleapis.com", "gmail.googleapis.com",
+			"/upload/gmail/v1/users/me/../me/messages?uploadType=media", "message/rfc822",
+			"google-base", "", pdobs.BasisServerName, "", pdobs.ReasonPathNotCanonical},
+		{"limit hit names the parent only", realApps(t, 0, 16), "gmail.googleapis.com", "gmail.googleapis.com", gmailUploadPath,
+			"message/rfc822", "google-base", "", pdobs.BasisServerName, pdobs.LimitPathBytes, pdobs.ReasonWorkLimit},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			tl := newLabAppTally(c.cls, c.sni)
+			tl.note(innerReq(t, "POST", c.host, c.path, c.ctype, 900))
+			b := tl.snapshot()
+			if b == nil || b.Requests != 1 || len(b.Apps) != 1 || b.AppsDropped != 0 || b.SchemaVersion != 1 {
+				t.Fatalf("block %+v", b)
+			}
+			a := b.Apps[0]
+			if a.App != c.wantApp || a.Container != c.wantContainer || a.Basis != c.wantBasis || a.Limit != c.wantLimit ||
+				a.Count != 1 || !labHas(a.Reasons, c.wantReason) {
+				t.Fatalf("got %+v, want app=%q container=%q basis=%q limit=%q reason %q", a, c.wantApp, c.wantContainer,
+					c.wantBasis, c.wantLimit, c.wantReason)
+			}
+			if c.wantLimit != "" && a.Container != "" {
+				t.Fatal("a limited verdict named a child")
+			}
+			if b.ChildRelease == "" || b.ContentRelease == "" {
+				t.Fatalf("releases missing: %+v", b)
+			}
+		})
+	}
+}
+
+func labHas(s []string, v string) bool {
+	for _, x := range s {
+		if x == v {
+			return true
+		}
+	}
+	return false
+}
+
+// TestLabChildAppTallyIsBounded: distinct verdicts stop at labAppsMaxDistinct, the rest are counted.
+func TestLabChildAppTallyIsBounded(t *testing.T) {
+	tl := newLabAppTally(nil, "")
+	for i := 0; i < labAppsMaxDistinct+5; i++ {
+		tl.add(protodetect.AppVerdict{App: fmt.Sprintf("app%d", i), Basis: "server_name"})
+	}
+	tl.add(protodetect.AppVerdict{App: "app0", Basis: "server_name"})
+	b := tl.snapshot()
+	if len(b.Apps) != labAppsMaxDistinct || b.AppsDropped != 5 || b.Requests != labAppsMaxDistinct+6 || b.Apps[0].Count != 2 {
+		t.Fatalf("block %+v", b)
+	}
+	// Open values never pass: a host-shaped app name, an unknown basis, reason or limit.
+	tl = newLabAppTally(nil, "")
+	tl.add(protodetect.AppVerdict{App: "mail.google.com/x", Container: "Gmail", Basis: "made_up", Limit: "lim",
+		Reasons: []string{"why"}, ChildRelease: "2026.11.1; drop", PackRelease: "2026.11.9"})
+	a := tl.snapshot()
+	if x := a.Apps[0]; x.App != pdobs.Unknown || x.Container != pdobs.Unknown || x.Basis != pdobs.Unknown ||
+		x.Limit != pdobs.Unknown || x.Reasons[0] != pdobs.Unknown || a.ChildRelease != "" || a.ContentRelease != "2026.11.9" {
+		t.Fatalf("open values passed: %+v", a)
+	}
+}
+
+// TestLabChildAppOffIsByteIdenticalAndAllocationFree: with the classifier off nothing is classified, no entry
+// is written, the hooks allocate nothing, and an entry without the block has no "pd" key.
+func TestLabChildAppOffIsByteIdenticalAndAllocationFree(t *testing.T) {
+	withLabApps(t, nil)
+	resetRequestLogState()
+	conn := tls.Client(nil, &tls.Config{MinVersion: tls.VersionTLS12})
+	req := innerReq(t, "POST", "gmail.googleapis.com", gmailUploadPath, "message/rfc822", 4)
+	ip := labIP()
+	allocs := testing.AllocsPerRun(200, func() {
+		apps := labAppsFor(conn)
+		apps.note(req)
+		labLogInspectClose(apps, "gmail.googleapis.com", nil, ProxyIdentity{ClientIP: ip}, nil)
+	})
+	if allocs != 0 {
+		t.Fatalf("off path allocates %.1f per tunnel", allocs)
+	}
+	if n := len(labEntries(ip)); n != 0 {
+		t.Fatalf("off path wrote %d entries", n)
+	}
+	js, _ := json.Marshal(LogEntry{Host: "h", Status: "TUNNEL_CLOSED"})
+	if strings.Contains(string(js), `"pd"`) {
+		t.Fatalf("pd key present when off: %s", js)
+	}
+}
+
+// --- an inspected HTTP/1.1 tunnel, end to end through runH1InspectLoop ---
+
+func labSelfSigned(t testing.TB, names ...string) tls.Certificate {
+	t.Helper()
+	k, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tpl := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: names[0]}, DNSNames: names,
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, tpl, tpl, &k.PublicKey, k)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return tls.Certificate{Certificate: [][]byte{der}, PrivateKey: k}
+}
+
+// labTLSPair returns the two ends of an in-memory TLS connection, already handshaked. proto is offered by
+// ALPN ("" for none).
+func labTLSPair(t testing.TB, sni, proto string) (client, server *tls.Conn) {
+	t.Helper()
+	a, b := net.Pipe()
+	var protos []string
+	if proto != "" {
+		protos = []string{proto}
+	}
+	server = tls.Server(b, &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{labSelfSigned(t, sni)}, NextProtos: protos})
+	client = tls.Client(a, &tls.Config{MinVersion: tls.VersionTLS12, ServerName: sni, InsecureSkipVerify: true, NextProtos: protos}) //nolint:gosec // in-memory lab test pair
+	errc := make(chan error, 1)
+	go func() { errc <- server.Handshake() }()
+	if err := client.Handshake(); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-errc; err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close(); server.Close() })
+	return client, server
+}
+
+// labOriginH1 answers every request on c with 200 and an empty body until the connection ends.
+func labOriginH1(c *tls.Conn) {
+	br := bufio.NewReader(c)
+	for {
+		req, err := http.ReadRequest(br)
+		if err != nil {
+			return
+		}
+		_, _ = io.Copy(io.Discard, req.Body)
+		if _, err := io.WriteString(c, "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"); err != nil {
+			return
+		}
+	}
+}
+
+var labIPSeq atomic.Int64
+
+// labIP returns a client IP no earlier run of any test in this process used (198.18.0.0/15, benchmarking).
+func labIP() string {
+	n := labIPSeq.Add(1)
+	return fmt.Sprintf("198.18.%d.%d", n/250, n%250+1)
+}
+
+// labEntries returns the request-log entries of one client IP (the ring is not cleared between tests, so
+// each test uses its own IP).
+func labEntries(ip string) []LogEntry {
+	var out []LogEntry
+	for _, e := range logGet() {
+		if e.IP == ip {
+			out = append(out, e)
+		}
+	}
+	return out
+}
+
+func tunnelClosedPD(t *testing.T, ip string) (LogEntry, *ProtoDetectBlock) {
+	t.Helper()
+	var found []LogEntry
+	for _, e := range labEntries(ip) {
+		if e.Status == "TUNNEL_CLOSED" && e.PD != nil {
+			found = append(found, e)
+		}
+	}
+	if len(found) != 1 {
+		t.Fatalf("want one TUNNEL_CLOSED entry with a pd block, got %d", len(found))
+	}
+	return found[0], found[0].PD
+}
+
+func TestLabChildAppInspectedH1TunnelLogsAppsOnTunnelClosed(t *testing.T) {
+	withLabApps(t, realApps(t, 0, 0))
+	resetRequestLogState()
+	swapTrafficKey(t, []byte("0123456789abcdef0123456789abcdef"))
+	swapDecRedact(t, true)
+
+	const host = "gmail.googleapis.com"
+	cli, clientTLS := labTLSPair(t, host, "")
+	upstreamTLS, originTLS := labTLSPair(t, host, "")
+	go labOriginH1(originTLS)
+	ip := labIP()
+	outer := &http.Request{Method: http.MethodConnect, Host: host + ":443", RemoteAddr: ip + ":5555"}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		runH1InspectLoop(outer, clientTLS, upstreamTLS, host, nil, ProxyIdentity{ClientIP: ip}, nil)
+	}()
+
+	br := bufio.NewReader(cli)
+	send := func(method, target, ctype, body string) {
+		t.Helper()
+		raw := fmt.Sprintf("%s %s HTTP/1.1\r\nHost: %s\r\nContent-Length: %d\r\n", method, target, host, len(body))
+		if ctype != "" {
+			raw += "Content-Type: " + ctype + "\r\n"
+		}
+		if _, err := io.WriteString(cli, raw+"\r\n"+body); err != nil {
+			t.Fatal(err)
+		}
+		resp, err := http.ReadResponse(br, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
+		if resp.StatusCode != 200 {
+			t.Fatalf("%s %s: status %d (visibility must not change the exchange)", method, target, resp.StatusCode)
+		}
+	}
+	send("POST", gmailUploadPath, "message/rfc822", "Subject: x\r\n\r\nhi")
+	send("POST", gmailUploadPath, "message/rfc822", "Subject: y\r\n\r\nhi")
+	send("GET", "/gmail/v1/users/me/labels", "", "")
+	cli.Close()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("inspect loop did not end")
+	}
+
+	e, b := tunnelClosedPD(t, ip)
+	if b.Requests != 3 || len(b.Apps) != 2 || b.AppsDropped != 0 {
+		t.Fatalf("block %+v", b)
+	}
+	if a := b.Apps[0]; a.App != "gmail-uploading" || a.Container != "gmail" || a.Basis != pdobs.BasisRequestRule || a.Count != 2 || a.Limit != "" {
+		t.Fatalf("first verdict %+v", a)
+	}
+	if a := b.Apps[1]; a.App != "google-base" || a.Container != "" || a.Basis != pdobs.BasisServerName || a.Count != 1 {
+		t.Fatalf("second verdict %+v", a)
+	}
+	if e.ActionTaken != labAppsAction || e.SSLAction != "inspect" || e.Method != http.MethodConnect {
+		t.Fatalf("entry %+v", e)
+	}
+	// Redaction: the host field is the keyed pseudonym, and nothing in the record names the host or a path.
+	js, _ := json.Marshal(e)
+	if !strings.HasPrefix(e.Host, "h_") || strings.Contains(string(js), "googleapis") || strings.Contains(string(js), "/upload") ||
+		strings.Contains(string(js), "uploadType") {
+		t.Fatalf("record leaks the destination: %s", js)
+	}
+}
