diff --git a/internal/pdobs/pdobs.go b/internal/pdobs/pdobs.go
new file mode 100644
index 000000000..5cd7ad349
--- /dev/null
+++ b/internal/pdobs/pdobs.go
@@ -0,0 +1,107 @@
+// Package pdobs holds the closed vocabularies of the LAB "pd" log block (protocol detector observation),
+// modelled on internal/decryptobs. LAB ONLY: never proposed upstream as-is.
+//
+// Only values listed here may appear as categorical fields of the block, so they are safe as metric labels
+// and SIEM fields (ADR-0011 rules: closed vocabularies only; no hostnames, paths or free text). A value the
+// detector library returns that is not listed is logged as Unknown, never passed through: the library can
+// grow a value before this list does, and the exhaustiveness test in internal/protodetect fails when it
+// does.
+package pdobs
+
+// Unknown replaces any categorical value that is not in its closed set.
+const Unknown = "unknown"
+
+// AppBasis is how the application of one decrypted request was established.
+const (
+	BasisNone        = "none"         // no application: the server name names none
+	BasisServerName  = "server_name"  // the server-name catalog; no child rule matched
+	BasisRequestRule = "request_rule" // a child rule refined the catalog's application
+)
+
+// AppLimit is the work ceiling a request hit (the verdict then names the parent only).
+const (
+	LimitRuleEvaluations = "child_rule_evaluations"
+	LimitPathBytes       = "child_path_bytes"
+	LimitFieldBytes      = "child_field_bytes"
+)
+
+// AppReason is one reason of an application verdict.
+const (
+	ReasonNoHost           = "no_host"
+	ReasonHostInvalid      = "host_invalid"
+	ReasonHostUnowned      = "host_unowned"
+	ReasonHostWebFront     = "host_web_front"
+	ReasonSNIHostMismatch  = "sni_host_owner_mismatch"
+	ReasonPathNotCanonical = "path_not_canonical"
+	ReasonFieldTooLong     = "field_too_long"
+	ReasonNoChildMatched   = "no_child_rule_matched"
+	ReasonChildMatched     = "child_rule_matched"
+	ReasonWorkLimit        = "work_limit"
+	ReasonPanic            = "panic"
+)
+
+// AllBases, AllLimits and AllReasons list each closed set.
+func AllBases() []string { return []string{BasisNone, BasisServerName, BasisRequestRule} }
+
+// AllLimits lists the AppLimit values (the empty value, no limit, is not one of them).
+func AllLimits() []string { return []string{LimitRuleEvaluations, LimitPathBytes, LimitFieldBytes} }
+
+// AllReasons lists the AppReason values.
+func AllReasons() []string {
+	return []string{ReasonNoHost, ReasonHostInvalid, ReasonHostUnowned, ReasonHostWebFront, ReasonSNIHostMismatch,
+		ReasonPathNotCanonical, ReasonFieldTooLong, ReasonNoChildMatched, ReasonChildMatched, ReasonWorkLimit, ReasonPanic}
+}
+
+func in(v string, set []string) bool {
+	for _, s := range set {
+		if v == s {
+			return true
+		}
+	}
+	return false
+}
+
+// Basis returns v when it is a closed AppBasis value, otherwise Unknown.
+func Basis(v string) string {
+	if in(v, AllBases()) {
+		return v
+	}
+	return Unknown
+}
+
+// Limit returns v when it is "" or a closed AppLimit value, otherwise Unknown.
+func Limit(v string) string {
+	if v == "" || in(v, AllLimits()) {
+		return v
+	}
+	return Unknown
+}
+
+// Reason returns v when it is a closed AppReason value, otherwise Unknown.
+func Reason(v string) string {
+	if in(v, AllReasons()) {
+		return v
+	}
+	return Unknown
+}
+
+// AppName returns v when it has the shape of a content-data application name (1 to 64 bytes of a-z, 0-9,
+// '-', '.' and '_', starting with a letter or digit), otherwise Unknown. Application names come from the
+// content data built into the binary, never from the request, but the shape check keeps a host, a path or
+// free text out of the block even if that ever changed.
+func AppName(v string) string {
+	if v == "" {
+		return ""
+	}
+	if len(v) > 64 {
+		return Unknown
+	}
+	for i := 0; i < len(v); i++ {
+		c := v[i]
+		ok := c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || i > 0 && (c == '-' || c == '.' || c == '_')
+		if !ok {
+			return Unknown
+		}
+	}
+	return v
+}
