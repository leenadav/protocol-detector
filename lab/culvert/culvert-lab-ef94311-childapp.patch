+package pdobs
+
+import "testing"
+
+func TestClosedSetsPassAndEverythingElseIsUnknown(t *testing.T) {
+	for _, v := range AllBases() {
+		if Basis(v) != v {
+			t.Fatalf("basis %q", v)
+		}
+	}
+	for _, v := range AllLimits() {
+		if Limit(v) != v {
+			t.Fatalf("limit %q", v)
+		}
+	}
+	for _, v := range AllReasons() {
+		if Reason(v) != v {
+			t.Fatalf("reason %q", v)
+		}
+	}
+	if Limit("") != "" || Basis("") != Unknown || Reason("") != Unknown || Basis("x") != Unknown || Limit("x") != Unknown {
+		t.Fatal("open values passed")
+	}
+	for _, v := range []string{"mail.google.com/x", "Gmail", "-a", "a b", "a/b", string(make([]byte, 65))} {
+		if AppName(v) != Unknown {
+			t.Fatalf("AppName(%q) passed", v)
+		}
+	}
+	for _, v := range []string{"gmail", "gmail-uploading", "google-base", "ms-base", "a"} {
+		if AppName(v) != v {
+			t.Fatalf("AppName(%q) refused", v)
+		}
+	}
+}
