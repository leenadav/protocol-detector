+++ b/childapp_lab.go
@@ -0,0 +1,199 @@
+package main
+
+// LAB ONLY (local branch, never proposed upstream as-is). PRO-504.
+//
+// Child applications on the decrypted-request path: every inner request of an INSPECTED tunnel (HTTP/1.1
+// keep-alive loop and HTTP/2 streams) is classified by the detector's AppClassifier, and the distinct
+// verdicts ride a log-only TUNNEL_CLOSED entry for the tunnel as the nested "pd" block. Visibility only:
+// nothing here reads or changes a policy match, a block decision, a header, a body or a deadline, and the
+// verdict is computed before the exchange runs and never passed to it.
+//
+//	CULVERT_LAB_CHILDAPP            off (default) | real
+//	CULVERT_LAB_CHILDAPP_MAX_RULES  rule evaluations per request (default 0: the library's 64)
+//	CULVERT_LAB_CHILDAPP_MAX_PATH   path bytes per request (default 0: the library's 4,096)
+//
+// Off: labAppsFor returns nil, every hook is a nil check, no entry is written and no allocation is added.
+// Inspected tunnels write no TUNNEL_CLOSED entry in Culvert ef94311 (the inspect-success terminal logs per
+// inner request); the lab adds one only when the classifier is on, gated by the rule's log-traffic flag like
+// every other TUNNEL_CLOSED entry. Its byte counts are 0: the inspected path accounts bytes per request, not
+// per tunnel, and this lab does not add a counter. ActionTaken says so.
+
+import (
+	"crypto/tls"
+	"net/http"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/KidCarmi/Culvert/internal/pdobs"
+	"github.com/KidCarmi/Culvert/internal/protodetect"
+)
+
+const (
+	labAppsMaxDistinct = 8  // distinct verdicts kept per tunnel; the rest are counted in apps_dropped
+	labAppsMaxHeaders  = 32 // header names passed to the classifier per request
+	labAppsAction      = "lab_childapp_summary"
+)
+
+var (
+	labAppsOnce       sync.Once
+	labAppsClassifier protodetect.AppClassifier // nil: off
+)
+
+func labAppsCls() protodetect.AppClassifier {
+	labAppsOnce.Do(func() {
+		if os.Getenv("CULVERT_LAB_CHILDAPP") != "real" {
+			return
+		}
+		rules, _ := strconv.Atoi(os.Getenv("CULVERT_LAB_CHILDAPP_MAX_RULES"))
+		path, _ := strconv.Atoi(os.Getenv("CULVERT_LAB_CHILDAPP_MAX_PATH"))
+		c, err := protodetect.NewRealApps(rules, path)
+		if err != nil {
+			logger.Printf("LAB childapp: classifier refused its configuration, it stays off: %v", err)
+			return
+		}
+		labAppsClassifier = c
+		logger.Printf("LAB childapp: application classification of decrypted requests ON (visibility only; lab build)")
+	})
+	return labAppsClassifier
+}
+
+// labAppTally collects the verdicts of one inspected tunnel. Its mutex is per tunnel, never global: the
+// HTTP/1.1 loop is one goroutine, and HTTP/2 streams of one tunnel are the only concurrent writers.
+type labAppTally struct {
+	cls   protodetect.AppClassifier
+	sni   string
+	start time.Time
+
+	mu    sync.Mutex
+	block ProtoDetectBlock
+}
+
+// labAppsFor returns the tunnel's tally, or nil when the lab classifier is off. The client's server name
+// is read only when the classifier is on, so the off path adds nothing.
+func labAppsFor(clientTLS *tls.Conn) *labAppTally {
+	c := labAppsCls()
+	if c == nil {
+		return nil
+	}
+	return newLabAppTally(c, clientTLS.ConnectionState().ServerName)
+}
+
+func newLabAppTally(c protodetect.AppClassifier, sni string) *labAppTally {
+	return &labAppTally{cls: c, sni: sni, start: time.Now(), block: ProtoDetectBlock{SchemaVersion: 1, Apps: []ProtoDetectApp{}}}
+}
+
+// labRequestPath is the origin-form path with its query as the client sent it: RequestURI on both the
+// HTTP/1.1 reader and the HTTP/2 server (its :path), before any reshaping. An absolute-form or empty
+// RequestURI falls back to the parsed URL's escaped form.
+func labRequestPath(req *http.Request) string {
+	if p := req.RequestURI; p != "" && p[0] == '/' {
+		return p
+	}
+	return req.URL.RequestURI()
+}
+
+// note classifies one decrypted request and adds its verdict. It must run before the exchange reshapes
+// the request (the HTTP/2 path clears RequestURI) and never touches req.
+func (t *labAppTally) note(req *http.Request) {
+	if t == nil {
+		return
+	}
+	var names []string
+	for k := range req.Header {
+		if len(names) == labAppsMaxHeaders {
+			break
+		}
+		names = append(names, k)
+	}
+	v := t.cls.Classify(protodetect.AppRequest{SNI: t.sni, Host: req.Host, Method: req.Method, Path: labRequestPath(req),
+		ContentType: req.Header.Get("Content-Type"), RequestBodyBytes: req.ContentLength,
+		WebSocket: isWebSocketUpgrade(req), HeaderNames: names})
+	t.add(v)
+}
+
+func (t *labAppTally) add(v protodetect.AppVerdict) {
+	e := ProtoDetectApp{App: pdobs.AppName(v.App), Container: pdobs.AppName(v.Container), Basis: pdobs.Basis(v.Basis),
+		Limit: pdobs.Limit(v.Limit), Reasons: make([]string, 0, len(v.Reasons))}
+	for _, r := range v.Reasons {
+		e.Reasons = append(e.Reasons, pdobs.Reason(r))
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	b := &t.block
+	b.Requests++
+	if b.ChildRelease == "" {
+		b.ChildRelease, b.ContentRelease = labRelease(v.ChildRelease), labRelease(v.PackRelease)
+	}
+	for i := range b.Apps {
+		if sameVerdict(b.Apps[i], e) {
+			b.Apps[i].Count++
+			return
+		}
+	}
+	if len(b.Apps) == labAppsMaxDistinct {
+		b.AppsDropped++
+		return
+	}
+	e.Count = 1
+	b.Apps = append(b.Apps, e)
+}
+
+func sameVerdict(a, b ProtoDetectApp) bool {
+	if a.App != b.App || a.Container != b.Container || a.Basis != b.Basis || a.Limit != b.Limit || len(a.Reasons) != len(b.Reasons) {
+		return false
+	}
+	for i := range a.Reasons {
+		if a.Reasons[i] != b.Reasons[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// labRelease keeps a YYYY.MM.N release string and nothing else.
+func labRelease(v string) string {
+	if len(v) == 0 || len(v) > 16 {
+		return ""
+	}
+	for i := 0; i < len(v); i++ {
+		if c := v[i]; !(c >= '0' && c <= '9' || c == '.') {
+			return ""
+		}
+	}
+	return v
+}
+
+// snapshot returns a copy of the block (nil for a nil tally or a tunnel with no classified request).
+func (t *labAppTally) snapshot() *ProtoDetectBlock {
+	if t == nil {
+		return nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.block.Requests == 0 {
+		return nil
+	}
+	b := t.block
+	b.Apps = append([]ProtoDetectApp{}, t.block.Apps...)
+	return &b
+}
+
+// labLogInspectClose writes the tunnel's log-only TUNNEL_CLOSED entry with the pd block. Host redaction is
+// persistLogEntry's (the keyed HMAC chokepoint); the block itself carries no host.
+func labLogInspectClose(t *labAppTally, hostOnly string, match *PolicyMatch, id ProxyIdentity, decBlock *DecryptionBlock) {
+	b := t.snapshot()
+	if b == nil {
+		return
+	}
+	if match != nil && match.Rule != nil && !ruleLogsTraffic(match.Rule) {
+		return
+	}
+	ruleName, ruleID := "", ""
+	if match != nil && match.Rule != nil {
+		ruleName, ruleID = match.Rule.Name, match.Rule.ID
+	}
+	persistLogEntry(id.ClientIP, http.MethodConnect, hostOnly, "TUNNEL_CLOSED", ruleName, labAppsAction, id.Identity,
+		0, 0, time.Since(t.start).Milliseconds(), "inspect", "", AuthLogFields{RuleID: ruleID, Dec: decBlock, AuthSource: id.AuthSource, PD: b})
+}
