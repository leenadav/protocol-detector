+			t.Errorf("%s: passes=%v verdict=%s reason=%s; want %v %s %s", c.name, got, o.verdict, o.reason, c.passes, c.verdict, c.reason)
+		}
+		first := o.verdict
+		o.restrict = &AppRestriction{Mode: "enforce", Allow: []string{"ssh"}, Unknown: "allow"}
+		if o.decide(); o.verdict != first {
+			t.Errorf("%s: the verdict changed on a second decide (%s -> %s); it must be decided once", c.name, first, o.verdict)
+		}
+	}
+}
