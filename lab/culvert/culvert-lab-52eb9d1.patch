+func TestLabSignals(t *testing.T) {
+	id := func(family, host string) protodetect.DirRecord {
+		return protodetect.DirRecord{Outcome: "identified", Family: family, Hostname: host}
+	}
+	cases := []struct {
+		name string
+		rec  protodetect.Record
+		dest string
+		want []string
+	}{
+		{"tls on 443, same host", protodetect.Record{Client: id("tls", "a.example.test"), Server: id("tls", "")}, "a.example.test:443", nil},
+		{"ssh on 443", protodetect.Record{Client: id("ssh", ""), Server: id("ssh", "")}, "a.example.test:443", []string{"nonstandard_port"}},
+		{"sni differs from the CONNECT host", protodetect.Record{Client: id("tls", "other.example.test"), Server: id("tls", "")}, "a.example.test:443", []string{"host_mismatch"}},
+		{"case and trailing dot are not a mismatch", protodetect.Record{Client: id("tls", "A.Example.Test."), Server: id("tls", "")}, "a.example.test:443", nil},
+		{"post-quantum server reply", protodetect.Record{Client: id("tls", "a.example.test"),
+			Server: protodetect.DirRecord{Outcome: "unknown", Detail: "Server key share group outside supported profile"}}, "a.example.test:443", []string{"server_unresolved"}},
+		{"nothing identified", protodetect.Record{Client: protodetect.DirRecord{Outcome: "unknown"}, Server: protodetect.DirRecord{Outcome: "unknown"}}, "a.example.test:9000", nil},
+	}
+	for _, c := range cases {
+		got := labSignals(c.rec, c.dest)
+		if len(got) != len(c.want) {
+			t.Errorf("%s: %v, want %v", c.name, got, c.want)
+			continue
+		}
+		for i := range got {
+			if got[i] != c.want[i] {
+				t.Errorf("%s: %v, want %v", c.name, got, c.want)
+			}
+		}
+	}
+}
+
+func TestLabObservationOffIsNil(t *testing.T) {
+	// With the detector off and no restriction on the matched rule there is no observation object,
+	// so handleTunnelBypass runs the unmodified relay path.
+	if labObs() == nil && labBeginObservation("example.test:443", nil) != nil {
+		t.Fatal("an observation was created with the detector off and no restriction")
+	}
+	var o *labObservation
+	if o.enforcing() || o.blocked() || o.labTakePrebuffer([]byte("x")) {
+		t.Fatal("a nil observation must be inert")
+	}
+	o.labRelease()
+}
