@@ -2733,3 +2738,55 @@ func lookupHostCategory(host string) (category, tier, matchedBy string) {
 type SSLBypassMatcher = sslbypass.Matcher
 
 var sslBypass = &SSLBypassMatcher{}
+
+// AppRestriction (LAB) restricts which detected protocol families may use a raw CONNECT tunnel that
+// a rule allows. The protocol detector observes the first bytes of the tunnel:
+//
+//   - Mode "monitor": nothing is held or blocked; the log entry records what enforce would have done.
+//   - Mode "enforce": the client's bytes are HELD (bounded) until the detector decides on the client
+//     direction, so no client byte of a disallowed protocol reaches the server. The server may speak
+//     first (SSH, SMTP greetings still flow back to the client).
+//
+// Unknown says what happens when the detector cannot name the protocol (unknown, incomplete,
+// budget exhausted, unsupported, engine failure, or the detector being unavailable): "allow" or
+// "block". There is no implicit default.
+type AppRestriction struct {
+	Mode    string   `json:"mode"`    // "monitor" | "enforce"
+	Allow   []string `json:"allow"`   // detector families, e.g. ["tls"]
+	Unknown string   `json:"unknown"` // "allow" | "block"
+}
+
+// appRestrictionFamilies are the families a restriction may name (the lab detector profile).
+var appRestrictionFamilies = []string{"http", "tls", "ssh", "smtp"}
+
+// validateAppRestriction rejects a malformed restriction. nil is valid (no restriction).
+func validateAppRestriction(rule PolicyRule) error {
+	ar := rule.AppRestriction
+	if ar == nil {
+		return nil
+	}
+	if rule.Action != ActionAllow {
+		return fmt.Errorf("protocol restriction is only valid on Allow rules")
+	}
+	if ar.Mode != "monitor" && ar.Mode != "enforce" {
+		return fmt.Errorf("protocol restriction mode must be monitor or enforce")
+	}
+	if ar.Unknown != "allow" && ar.Unknown != "block" {
+		return fmt.Errorf("protocol restriction needs an explicit unknown action: allow or block")
+	}
+	if len(ar.Allow) == 0 {
+		return fmt.Errorf("protocol restriction needs at least one allowed protocol")
+	}
+	seen := map[string]bool{}
+	for _, f := range ar.Allow {
+		ok := false
+		for _, known := range appRestrictionFamilies {
+			ok = ok || f == known
+		}
+		if !ok || seen[f] {
+			return fmt.Errorf("protocol restriction: unknown or repeated protocol")
+		}
+		seen[f] = true
+	}
+	return nil
+}
