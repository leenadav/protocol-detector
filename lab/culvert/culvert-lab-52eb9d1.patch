+func TestLabAppRestrictionValidation(t *testing.T) {
+	ok := &AppRestriction{Mode: "enforce", Allow: []string{"tls"}, Unknown: "block"}
+	cases := []struct {
+		name string
+		rule PolicyRule
+		bad  bool
+	}{
+		{"no restriction", PolicyRule{Action: ActionAllow}, false},
+		{"valid enforce", PolicyRule{Action: ActionAllow, AppRestriction: ok}, false},
+		{"valid monitor", PolicyRule{Action: ActionAllow, AppRestriction: &AppRestriction{Mode: "monitor", Allow: []string{"tls", "ssh"}, Unknown: "allow"}}, false},
+		{"on a block rule", PolicyRule{Action: ActionDrop, AppRestriction: ok}, true},
+		{"bad mode", PolicyRule{Action: ActionAllow, AppRestriction: &AppRestriction{Mode: "on", Allow: []string{"tls"}, Unknown: "block"}}, true},
+		{"no unknown action", PolicyRule{Action: ActionAllow, AppRestriction: &AppRestriction{Mode: "enforce", Allow: []string{"tls"}}}, true},
+		{"empty allow", PolicyRule{Action: ActionAllow, AppRestriction: &AppRestriction{Mode: "enforce", Unknown: "block"}}, true},
+		{"unknown family", PolicyRule{Action: ActionAllow, AppRestriction: &AppRestriction{Mode: "enforce", Allow: []string{"gopher"}, Unknown: "block"}}, true},
+		{"repeated family", PolicyRule{Action: ActionAllow, AppRestriction: &AppRestriction{Mode: "enforce", Allow: []string{"tls", "tls"}, Unknown: "block"}}, true},
+	}
+	for _, c := range cases {
+		if err := validateAppRestriction(c.rule); (err != nil) != c.bad {
+			t.Errorf("%s: err=%v, want error=%v", c.name, err, c.bad)
+		}
+	}
+}
