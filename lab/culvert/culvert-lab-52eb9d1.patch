diff --git a/frontend/src/features/monitor/ProtocolDetection.tsx b/frontend/src/features/monitor/ProtocolDetection.tsx
new file mode 100644
index 0000000..84a2f79
--- /dev/null
+++ b/frontend/src/features/monitor/ProtocolDetection.tsx
@@ -0,0 +1,303 @@
+// LAB (local branch lab/protocol-detector): the protocol detector's observation
+// of a raw tunnel (TrafficEntry.pd), read the way the Protocol Observatory
+// reads a session: what was identified, the layers, the signals, a
+// per-direction timeline and the evidence ledger. Every label comes from the
+// detector's closed vocabularies; host names and ALPN offers are peer
+// assertions and are shown as such.
+import type { JSX } from "react";
+import type { TrafficPd, TrafficPdDirection } from "../../api/ops";
+import { KeyValue, Mono, StatusBadge } from "../../design-system/primitives";
+import type { Status } from "../../design-system/primitives";
+import styles from "./monitor.module.css";
+
+const OUTCOME: Record<string, readonly [Status, string]> = {
+  identified: ["ok", "Identified"],
+  unknown: ["unknown", "Unresolved"],
+  incomplete: ["neutral", "Incomplete"],
+  outside_profile: ["warn", "Outside profile"],
+  budget_exhausted: ["warn", "Budget exhausted"],
+  unsupported: ["neutral", "Unsupported"],
+  malformed: ["warn", "Malformed"],
+  invalidated: ["warn", "Retracted"],
+  failed: ["critical", "Engine failed"],
+  detecting: ["neutral", "Detecting"],
+};
+
+const SIGNAL: Record<string, string> = {
+  nonstandard_port: "Protocol on a port it is not usually seen on",
+  host_mismatch: "Client-asserted host differs from the CONNECT destination",
+  server_unresolved: "Server reply not recognised by the detector",
+};
+
+const VERDICT: Record<string, readonly [Status, string]> = {
+  allowed: ["ok", "Allowed by restriction"],
+  would_block: ["warn", "Would block (monitor)"],
+  blocked: ["critical", "Blocked by restriction"],
+};
+
+const REASON: Record<string, string> = {
+  protocol_allowed: "the detected protocol is in the rule's allowed list",
+  protocol_not_allowed:
+    "the detected protocol is not in the rule's allowed list",
+  unknown_allowed: "the protocol could not be named; the rule allows unknown",
+  unknown_blocked: "the protocol could not be named; the rule blocks unknown",
+  detector_unavailable:
+    "the detector was unavailable; the rule's unknown action was applied",
+};
+
+function outcomeOf(d: TrafficPdDirection): readonly [Status, string] {
+  return OUTCOME[d.outcome] ?? ["neutral", d.outcome];
+}
+
+export function pdName(d: TrafficPdDirection): string {
+  if (d.encryption !== "") return d.encryption.toUpperCase();
+  if (d.protocol !== "") return d.protocol.toUpperCase();
+  return d.family.toUpperCase();
+}
+
+/** The direction the row is labelled by: the client if it identified,
+ * otherwise the server if it did, otherwise the client. */
+function lead(pd: TrafficPd): TrafficPdDirection {
+  if (pd.client.outcome === "identified") return pd.client;
+  if (pd.server.outcome === "identified") return pd.server;
+  return pd.client;
+}
+
+/** Summary of what the detector observed in the rows on screen (the
+ * Observatory's "application mix", for a traffic page). */
+export function PdMix({
+  rows,
+}: {
+  rows: ReadonlyArray<{ pd: TrafficPd | null }>;
+}): JSX.Element | null {
+  const counts = new Map<string, number>();
+  let observed = 0;
+  let blocked = 0;
+  let wouldBlock = 0;
+  let signals = 0;
+  for (const r of rows) {
+    if (r.pd === null) continue;
+    observed += 1;
+    const d = lead(r.pd);
+    const key =
+      d.outcome === "identified"
+        ? pdName(d)
+        : d.outcome === "outside_profile"
+          ? `${pdName(d)} (outside profile)`
+          : outcomeOf(d)[1];
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+    if (r.pd.policy?.verdict === "blocked") blocked += 1;
+    if (r.pd.policy?.verdict === "would_block") wouldBlock += 1;
+    if (r.pd.signals.length > 0) signals += 1;
+  }
+  if (observed === 0) return null;
+  const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1]);
+  return (
+    <div className={styles.pdMix} role="status" aria-label="Protocol mix">
+      <span className={styles.pdMixTitle}>
+        Protocol mix · {String(observed)} observed tunnels on this page
+      </span>
+      {sorted.map(([k, n]) => (
+        <span key={k} className={styles.pdMixChip}>
+          <strong>{k}</strong> {String(n)}
+        </span>
+      ))}
+      {blocked > 0 && (
+        <StatusBadge status="critical">{String(blocked)} blocked</StatusBadge>
+      )}
+      {wouldBlock > 0 && (
+        <StatusBadge status="warn">
+          {String(wouldBlock)} would block
+        </StatusBadge>
+      )}
+      {signals > 0 && (
+        <StatusBadge status="warn">{String(signals)} with signals</StatusBadge>
+      )}
+    </div>
+  );
+}
+
+/** Table cell: the application / protocol the detector observed. */
+export function PdCell({ pd }: { pd: TrafficPd | null }): JSX.Element {
+  if (pd === null) return <span className={styles.pdMuted}>—</span>;
+  const d = lead(pd);
+  const [status, label] = outcomeOf(d);
+  const name = pdName(d);
+  const host =
+    pd.client.hostname !== "" ? pd.client.hostname : pd.server.hostname;
+  return (
+    <div className={styles.pdCell}>
+      <div className={styles.pdLine}>
+        <StatusBadge status={status}>{label}</StatusBadge>
+        {name !== "" && <strong>{name}</strong>}
+        {pd.policy !== null && pd.policy.verdict !== "allowed" && (
+          <StatusBadge status={(VERDICT[pd.policy.verdict] ?? ["warn", ""])[0]}>
+            {pd.policy.verdict === "blocked" ? "Blocked" : "Would block"}
+          </StatusBadge>
+        )}
+        {pd.signals.length > 0 && (
+          <StatusBadge status="warn">
+            {String(pd.signals.length)} signal
+            {pd.signals.length > 1 ? "s" : ""}
+          </StatusBadge>
+        )}
+      </div>
+      {host !== "" && (
+        <div
+          className={styles.pdHost}
+          title="Asserted by the client (SNI / Host); not authenticated identity"
+        >
+          {host}
+        </div>
+      )}
+    </div>
+  );
+}
+
+function Direction({
+  title,
+  d,
+}: {
+  title: string;
+  d: TrafficPdDirection;
+}): JSX.Element {
+  const [status, label] = outcomeOf(d);
+  const name = pdName(d);
+  return (
+    <div className={styles.pdEvent}>
+      <div className={styles.pdEventHead}>{title}</div>
+      <div className={styles.pdLine}>
+        <StatusBadge status={status}>{label}</StatusBadge>
+        <strong>{name === "" ? "—" : name}</strong>
+        <span className={styles.pdMuted}>
+          {d.reason} · {String(d.observedBytes)} bytes observed
+        </span>
+      </div>
+      {d.detail !== "" && <p className={styles.pdReason}>{d.detail}</p>}
+    </div>
+  );
+}
+
+/** Row detail: layers, policy, signals, timeline and evidence ledger. */
+export function PdDetail({ pd }: { pd: TrafficPd }): JSX.Element {
+  const d = lead(pd);
+  const layers = ["TCP"];
+  const name = pdName(d);
+  if (d.outcome === "identified" && name !== "") layers.push(name);
+  const ledger = [
+    ...pd.client.evidence.map((e) => ({ ...e, dir: "client" })),
+    ...pd.server.evidence.map((e) => ({ ...e, dir: "server" })),
+  ];
+  const alpn = pd.client.offeredAlpn;
+  return (
+    <section className={styles.pdDetail} aria-label="Protocol detection">
+      <h3 className={styles.pdTitle}>Protocol detection</h3>
+      <div className={styles.pdLayers}>
+        {layers.map((l, i) => (
+          <span key={l}>
+            {i > 0 && <span className={styles.pdMuted}> → </span>}
+            <span className={styles.pdLayer}>{l}</span>
+          </span>
+        ))}
+        {pd.quarantined && (
+          <StatusBadge status="critical">Flow quarantined</StatusBadge>
+        )}
+      </div>
+
+      {pd.policy !== null && (
+        <div className={styles.pdBlock}>
+          <h4 className={styles.pdSub}>Rule protocol restriction</h4>
+          <KeyValue
+            items={[
+              [
+                "Verdict",
+                <StatusBadge
+                  key="v"
+                  status={(VERDICT[pd.policy.verdict] ?? ["neutral", ""])[0]}
+                >
+                  {(VERDICT[pd.policy.verdict] ?? ["", pd.policy.verdict])[1]}
+                </StatusBadge>,
+              ],
+              ["Why", REASON[pd.policy.reason] ?? pd.policy.reason],
+              ["Mode", pd.policy.mode],
+              ["Allowed protocols", pd.policy.allow.join(", ").toUpperCase()],
+              [
+                "Client bytes held for the decision",
+                pd.policy.mode === "enforce"
+                  ? `${String(pd.policy.heldBytes)} (none forwarded on a block)`
+                  : "not held in monitor mode",
+              ],
+            ]}
+          />
+        </div>
+      )}
+
+      <div className={styles.pdBlock}>
+        <h4 className={styles.pdSub}>
+          Signals <span className={styles.pdCount}>{pd.signals.length}</span>
+        </h4>
+        {pd.signals.length === 0 ? (
+          <p className={styles.pdNote}>No advisory signals were raised.</p>
+        ) : (
+          <ul className={styles.pdSignals}>
+            {pd.signals.map((s) => (
+              <li key={s}>{SIGNAL[s] ?? s}</li>
+            ))}
+          </ul>
+        )}
+        <p className={styles.pdNote}>
+          Signals describe what was observed. They do not mean the tunnel is
+          malicious or was blocked.
+        </p>
+      </div>
+
+      <div className={styles.pdBlock}>
+        <h4 className={styles.pdSub}>Detection timeline</h4>
+        <Direction title="Client → server" d={pd.client} />
+        <Direction title="Server → client" d={pd.server} />
+      </div>
+
+      <div className={styles.pdBlock}>
+        <h4 className={styles.pdSub}>
+          Evidence ledger{" "}
+          <span className={styles.pdCount}>{ledger.length}</span>
+        </h4>
+        {ledger.length === 0 ? (
+          <p className={styles.pdNote}>
+            No structural evidence was established.
+          </p>
+        ) : (
+          <table className={styles.pdLedger}>
+            <tbody>
+              {ledger.map((e, i) => (
+                <tr key={`${e.dir}-${e.field}-${String(i)}`}>
+                  <th scope="row">{e.field}</th>
+                  <td>
+                    {e.cls === "withheld" ? (
+                      <em>withheld</em>
+                    ) : (
+                      <Mono>{e.value}</Mono>
+                    )}
+                  </td>
+                  <td className={styles.pdMuted}>
+                    {e.dir} · {e.source} · {e.strength}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        )}
+        {alpn.length > 0 && (
+          <p className={styles.pdNote}>
+            ALPN offered by the client: <Mono>{alpn.join(", ")}</Mono> (an
+            offer, not the negotiated protocol).
+          </p>
+        )}
+      </div>
+      <p className={styles.pdNote}>
+        Engine: {pd.engine}. Lab build. Host names and ALPN are peer assertions,
+        not authenticated identity.
+      </p>
+    </section>
+  );
+}
