+package protodetect
+
+// LAB ONLY. Culvert-owned interface to the detector's application classifier for DECRYPTED requests
+// (an inspected tunnel's inner HTTP requests). Visibility only: a verdict never feeds a policy decision.
+
+// AppRequest is what the inspection pipeline saw of one decrypted request. Values are borrowed for the call.
+type AppRequest struct {
+	SNI              string // the client's TLS server name on the tunnel
+	Host             string // the inner request's Host or :authority
+	Method           string
+	Path             string // origin-form, with its query, as the client sent it
+	ContentType      string
+	RequestBodyBytes int64 // negative: unknown
+	WebSocket        bool
+	HeaderNames      []string
+}
+
+// AppVerdict is the classifier's answer. Basis, Reasons and Limit are the library's closed vocabularies;
+// the caller maps them through internal/pdobs before logging.
+type AppVerdict struct {
+	App, Container, Basis, Limit string
+	Reasons                      []string
+	ChildRelease, PackRelease    string
+}
+
+// AppClassifier classifies decrypted requests. Implementations must be safe for concurrent use and must not
+// panic into the caller.
+type AppClassifier interface {
+	Classify(AppRequest) AppVerdict
+}
