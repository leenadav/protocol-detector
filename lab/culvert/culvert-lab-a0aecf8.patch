+}
+
+// --- an inspected HTTP/2 tunnel, end to end through handleInspectH2 ---
+
+func TestLabChildAppInspectedH2TunnelLogsAppsOnTunnelClosed(t *testing.T) {
+	withLabApps(t, realApps(t, 0, 0))
+	resetRequestLogState()
+
+	const host = "gmail.googleapis.com"
+	cli, clientTLS := labTLSPair(t, host, "h2")
+	upstreamTLS, originTLS := labTLSPair(t, host, "h2")
+	go (&http2.Server{}).ServeConn(originTLS, &http2.ServeConnOpts{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.WriteHeader(200)
+	})})
+	ip := labIP()
+	outer := &http.Request{Method: http.MethodConnect, Host: host + ":443", RemoteAddr: ip + ":5555"}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		handleInspectH2(outer, clientTLS, upstreamTLS, host, nil, ProxyIdentity{ClientIP: ip}, nil)
+	}()
+
+	cc, err := (&http2.Transport{}).NewClientConn(cli)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ { // concurrent streams: the tally's only concurrent writers
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			req, _ := http.NewRequest("POST", "https://"+host+gmailUploadPath, strings.NewReader("Subject: x\r\n\r\nhi"))
+			req.Header.Set("Content-Type", "message/rfc822")
+			resp, err := cc.RoundTrip(req)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			resp.Body.Close()
+			if resp.StatusCode != 200 {
+				t.Errorf("status %d", resp.StatusCode)
+			}
+		}()
+	}
+	wg.Wait()
+	cc.Close()
+	cli.Close()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("h2 tunnel did not end")
+	}
+	_, b := tunnelClosedPD(t, ip)
+	if b.Requests != 4 || len(b.Apps) != 1 || b.Apps[0].App != "gmail-uploading" || b.Apps[0].Container != "gmail" || b.Apps[0].Count != 4 {
+		t.Fatalf("block %+v", b)
+	}
+}
+
+// --- cost per decrypted request (PRO-504 item 3) ---
+
+// BenchmarkLabChildAppNote is the added work per decrypted request when the lab classifier is on:
+// building the request view, Classify and the tally update.
+func BenchmarkLabChildAppNote(b *testing.B) {
+	cls := realApps(b, 0, 0)
+	for _, c := range []struct{ name, host, path, ctype string }{
+		{"child", "gmail.googleapis.com", gmailUploadPath, "message/rfc822"},
+		{"parent", "gmail.googleapis.com", "/gmail/v1/users/me/labels", ""},
+		{"unowned", "unowned.example", "/upload", ""},
+	} {
+		b.Run(c.name, func(b *testing.B) {
+			req := innerReq(b, "POST", c.host, c.path, c.ctype, 16)
+			tl := newLabAppTally(cls, c.host)
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				tl.note(req)
+			}
+		})
+	}
+}
+
+// BenchmarkLabChildAppTunnel is the added work per inspected tunnel: the tally, one note and the
+// TUNNEL_CLOSED snapshot (persistLogEntry itself is Culvert's per-entry cost and is excluded).
+func BenchmarkLabChildAppTunnel(b *testing.B) {
+	cls := realApps(b, 0, 0)
+	req := innerReq(b, "POST", "gmail.googleapis.com", gmailUploadPath, "message/rfc822", 16)
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		tl := newLabAppTally(cls, "gmail.googleapis.com")
+		tl.note(req)
+		_ = tl.snapshot()
+	}
+}
+
+// BenchmarkLabChildAppInspectedH1 prices the lab on the real path: b.N keep-alive requests (the gmail
+// upload) through one inspected HTTP/1.1 tunnel (runH1InspectLoop over in-memory TLS pairs), classifier
+// off and on. The difference between the two arms is the per-request cost; allocations count the whole
+// process (client, proxy loop and origin), so only the difference is the lab's.
+func BenchmarkLabChildAppInspectedH1(b *testing.B) {
+	prevLogger := logger
+	logger = log.New(io.Discard, "", 0) // the per-request SSL_INNER line is the same in both arms
+	defer func() { logger = prevLogger }()
+	for _, arm := range []struct {
+		name string
+		on   bool
+	}{{"off", false}, {"on", true}} {
+		b.Run(arm.name, func(b *testing.B) {
+			labAppsCls()
+			prev := labAppsClassifier
+			labAppsClassifier = nil
+			if arm.on {
+				labAppsClassifier = realApps(b, 0, 0)
+			}
+			defer func() { labAppsClassifier = prev }()
+			const host = "gmail.googleapis.com"
+			cli, clientTLS := labTLSPair(b, host, "")
+			upstreamTLS, originTLS := labTLSPair(b, host, "")
+			go labOriginH1(originTLS)
+			outer := &http.Request{Method: http.MethodConnect, Host: host + ":443", RemoteAddr: "192.0.2.20:5555"}
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				runH1InspectLoop(outer, clientTLS, upstreamTLS, host, nil, ProxyIdentity{ClientIP: "192.0.2.20"}, nil)
+			}()
+			raw := []byte("POST " + gmailUploadPath + " HTTP/1.1\r\nHost: " + host +
+				"\r\nContent-Type: message/rfc822\r\nContent-Length: 16\r\n\r\nSubject: x\r\n\r\nhi")
+			br := bufio.NewReader(cli)
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				if _, err := cli.Write(raw); err != nil {
+					b.Fatal(err)
+				}
+				resp, err := http.ReadResponse(br, nil)
+				if err != nil {
+					b.Fatal(err)
+				}
+				_, _ = io.Copy(io.Discard, resp.Body)
+				resp.Body.Close()
+			}
+			b.StopTimer()
+			cli.Close()
+			<-done
+		})
+	}
+}
