+package protodetect
+
+import (
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/KidCarmi/Culvert/internal/pdobs"
+)
+
+// TestPdobsCoversTheLibraryAppVocabulary fails when the library gains a basis, reason or limit that the
+// lab's closed sets do not list (it would otherwise be logged as "unknown").
+func TestPdobsCoversTheLibraryAppVocabulary(t *testing.T) {
+	bases, reasons, limits := LibraryAppVocab()
+	for _, c := range []struct {
+		name     string
+		lib, lab []string
+	}{{"bases", bases, pdobs.AllBases()}, {"reasons", reasons, pdobs.AllReasons()}, {"limits", limits, pdobs.AllLimits()}} {
+		a, b := append([]string{}, c.lib...), append([]string{}, c.lab...)
+		sort.Strings(a)
+		sort.Strings(b)
+		if strings.Join(a, ",") != strings.Join(b, ",") {
+			t.Errorf("%s: library %v, pdobs %v", c.name, a, b)
+		}
+	}
+}
+
+// BenchmarkRealAppsClassify is the library's share of the per-request cost (Classify alone, the wrapper's
+// recover included), so the lab hook's own share is BenchmarkLabChildAppNote minus this.
+func BenchmarkRealAppsClassify(b *testing.B) {
+	c, err := NewRealApps(0, 0)
+	if err != nil {
+		b.Fatal(err)
+	}
+	for _, q := range []struct {
+		name string
+		req  AppRequest
+	}{
+		{"child", AppRequest{SNI: "gmail.googleapis.com", Host: "gmail.googleapis.com", Method: "POST",
+			Path: "/upload/gmail/v1/users/me/messages?uploadType=media", ContentType: "message/rfc822", RequestBodyBytes: 16,
+			HeaderNames: []string{"Content-Type", "Content-Length"}}},
+		{"parent", AppRequest{SNI: "gmail.googleapis.com", Host: "gmail.googleapis.com", Method: "POST",
+			Path: "/gmail/v1/users/me/labels", RequestBodyBytes: 16, HeaderNames: []string{"Content-Length"}}},
+		{"unowned", AppRequest{SNI: "unowned.example", Host: "unowned.example", Method: "POST", Path: "/upload",
+			RequestBodyBytes: 16, HeaderNames: []string{"Content-Length"}}},
+	} {
+		b.Run(q.name, func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				_ = c.Classify(q.req)
+			}
+		})
+	}
+}
