+package main
+
+// LAB: tests of the visibility-only observation tap (local lab branch; not for upstream as-is).
+
+import (
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/KidCarmi/Culvert/internal/protodetect"
+)
+
+// withLabObserver installs obs as the lab observer with the given window for one test.
+func withLabObserver(t *testing.T, obs protodetect.Observer, window time.Duration) {
+	t.Helper()
+	labOnce.Do(func() {}) // the environment never configures the observer in tests
+	origObs, origWindow := labObserver, labWindow
+	labObserver, labWindow = obs, window
+	t.Cleanup(func() { labObserver, labWindow = origObs, origWindow })
+}
+
+// labTunnel runs the observed relay between two pipes, as handleTunnelBypass does. The returned peers are
+// the client's and the origin's ends; closing both ends the relay, and wait returns once it has.
+func labTunnel(o *labObservation) (client, origin net.Conn, wait func()) {
+	clientConn, clientPeer := net.Pipe()
+	destConn, destPeer := net.Pipe()
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		labBidiRelay(o, destConn, clientConn)
+		clientConn.Close() //nolint:errcheck
+		destConn.Close()   //nolint:errcheck
+	}()
+	return clientPeer, destPeer, func() {
+		clientPeer.Close() //nolint:errcheck
+		destPeer.Close()   //nolint:errcheck
+		wg.Wait()
+	}
+}
+
+func labWaitFor(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+// SEC-CULV-1: idle tunnels must not keep the engine's admission slots past the observation window. Before
+// the fix a flow was finished only when its tunnel closed, so MaxFlows idle tunnels left every later tunnel
+// unobserved (and, with no record, invisible).
+func TestLabWindowEndReleasesAdmissionWhileTunnelsStayOpen(t *testing.T) {
+	fake := &protodetect.Fake{NeedBytes: 16, MaxFlows: 2}
+	withLabObserver(t, fake, 50*time.Millisecond)
+	var obs []*labObservation
+	var waits []func()
+	for i := 0; i < 2; i++ {
+		o := labBeginObservation("origin.lab.test:443")
+		if o == nil || o.flow == nil {
+			t.Fatalf("tunnel %d was not admitted", i)
+		}
+		_, _, wait := labTunnel(o) // both peers stay silent: idle tunnels
+		obs, waits = append(obs, o), append(waits, wait)
+	}
+	if fake.Stats().Active != 2 {
+		t.Fatalf("active %d, want 2", fake.Stats().Active)
+	}
+	labWaitFor(t, "the window to release both admission slots", func() bool { return fake.Stats().Active == 0 })
+	// The two tunnels are still open; a third one is admitted.
+	third := labBeginObservation("origin.lab.test:443")
+	if third == nil || third.flow == nil || third.refused {
+		t.Fatal("a new tunnel was refused while the earlier ones only sat idle past their window")
+	}
+	third.finish()
+	for i, wait := range waits {
+		wait()
+		out := captureLogger(t, func() { labFinishObservation(obs[i], nil, "origin.lab.test:443", 0, 0) })
+		if !strings.Contains(out, "PROTODETECT ") || strings.Contains(out, `"admission"`) {
+			t.Fatalf("tunnel %d: the record kept until close was not logged as observed: %q", i, out)
+		}
+	}
+	if st := fake.Stats(); st.Active != 0 || st.Refused != 0 {
+		t.Fatalf("end state %+v", st)
+	}
+}
+
+// SEC-CULV-1: once both directions are decided and handed back to the splice path, the flow is released at
+// once, long before the window ends, while the tunnel goes on relaying.
+func TestLabHandoffReleasesAdmissionBeforeTheWindowEnds(t *testing.T) {
+	fake := &protodetect.Fake{NeedBytes: 4, MaxFlows: 1}
+	withLabObserver(t, fake, time.Minute)
+	o := labBeginObservation("origin.lab.test:22")
+	client, origin, wait := labTunnel(o)
+	relay := func(from, to net.Conn, msg string) {
+		go from.Write([]byte(msg)) //nolint:errcheck
+		buf := make([]byte, len(msg))
+		if _, err := io.ReadFull(to, buf); err != nil || string(buf) != msg {
+			t.Fatalf("relayed %q %v, want %q", buf, err, msg)
+		}
+	}
+	relay(client, origin, "SSH-2.0-client\r\n")
+	relay(origin, client, "SSH-2.0-server\r\n")
+	labWaitFor(t, "the handoff to release the admission slot", func() bool { return fake.Stats().Active == 0 })
+	relay(client, origin, "after the handoff") // the tunnel still relays, now on the normal copy path
+	if next := labBeginObservation("origin.lab.test:22"); next == nil || next.refused {
+		t.Fatal("the only admission slot is still held after both directions handed off")
+	} else {
+		next.finish()
+	}
+	wait()
+	out := captureLogger(t, func() { labFinishObservation(o, nil, "origin.lab.test:22", 0, 0) })
+	if !strings.Contains(out, `"outcome":"identified"`) {
+		t.Fatalf("the kept record lost the identification: %q", out)
+	}
+}
+
+// SEC-CULV-1: a tunnel the engine refused relays unobserved and still leaves a record.
+func TestLabRefusedAdmissionIsLogged(t *testing.T) {
+	fake := &protodetect.Fake{NeedBytes: 16, MaxFlows: 1}
+	withLabObserver(t, fake, time.Minute)
+	held := labBeginObservation("a.lab.test:443")
+	refused := labBeginObservation("b.lab.test:443")
+	if refused == nil || !refused.refused || refused.flow != nil {
+		t.Fatalf("second tunnel: %+v, want a refused observation", refused)
+	}
+	out := captureLogger(t, func() { labFinishObservation(refused, nil, "b.lab.test:443", 10, 20) })
+	for _, want := range []string{`"admission":"refused"`, `"reason":"admission_refused"`, `"outcome":"unobserved"`, `"forwarded_bytes":[10,20]`} {
+		if !strings.Contains(out, want) {
+			t.Errorf("refused record lacks %s: %q", want, out)
+		}
+	}
+	held.finish()
+	if st := fake.Stats(); st.Active != 0 || st.Refused != 1 {
+		t.Fatalf("end state %+v", st)
+	}
+}
+
+// stubFlow returns a fixed record, so the logging path can be checked with a hostname the fake cannot give.
+type stubFlow struct{ rec protodetect.Record }
+
+func (s stubFlow) Observe(protodetect.Direction, []byte) bool { return true }
+func (s stubFlow) End(protodetect.Direction)                  {}
+func (s stubFlow) Expire()                                    {}
+func (s stubFlow) Finish() protodetect.Record                 { return s.rec }
+
+// SEC-CULV-2: the host comparison is made on the unredacted values. With redaction on, the hostnames are
+// pseudonymized in the record, yet a mismatch is still flagged, and the flag carries no host.
+func TestLabHostMismatchIsComputedBeforeRedaction(t *testing.T) {
+	withLabObserver(t, &protodetect.Fake{}, time.Minute)
+	orig := decRedactHosts()
+	setDecRedactHosts(true)
+	t.Cleanup(func() { setDecRedactHosts(orig) })
+	for _, c := range []struct {
+		sni, dest string
+		mismatch  bool
+	}{
+		{"other.example.test", "origin.lab.test:443", true},
+		{"Origin.Lab.Test.", "origin.lab.test:443", false},
+	} {
+		o := &labObservation{flow: stubFlow{protodetect.Record{Engine: "stub",
+			Client: protodetect.DirRecord{Outcome: "identified", Family: "tls", Hostname: c.sni}}}}
+		out := captureLogger(t, func() { labFinishObservation(o, nil, c.dest, 0, 0) })
+		if got := strings.Contains(out, `"signals":["host_mismatch"]`); got != c.mismatch {
+			t.Errorf("sni %q dest %q: host_mismatch %v, want %v: %q", c.sni, c.dest, got, c.mismatch, out)
+		}
+		if strings.Contains(strings.ToLower(out), strings.ToLower(strings.TrimSuffix(c.sni, "."))) {
+			t.Errorf("sni %q: the plaintext host reached the log with redaction on: %q", c.sni, out)
+		}
+	}
+}
+
+func TestLabSignalsCompareHostsPortNormalised(t *testing.T) {
+	rec := func(host string) protodetect.Record {
+		return protodetect.Record{Client: protodetect.DirRecord{Outcome: "identified", Hostname: host}}
