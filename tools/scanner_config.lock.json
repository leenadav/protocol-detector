  "pyproject.toml": [
   "[tool.ruff]",
   "line-length = 160",
   "target-version = \"py39\"",
   "",
   "[tool.ruff.lint]",
   "# Correctness and security rules only; style is not a CI gate.",
   "select = [\"E9\", \"F\", \"B\", \"S\", \"PLE\", \"W605\", \"PGH004\"]   # PGH004: a noqa must name its rule",
   "ignore = [",
   "  \"B011\",  # assert False in tests is deliberate",
   "  \"S101\",  # asserts are test code",
   "  \"S311\",  # random is used for seeded fuzzing, never for secrets",
   "  \"B904\",  # explicit `raise ... from None` is used where chaining would leak",
   "  \"B905\",  # zip(strict=) is Python 3.10+",
   "  \"B007\",  # historical benchmark scripts keep their loop variables",
   "]",
   "",
   "[tool.ruff.lint.per-file-ignores]",
   "\"test_*.py\" = [\"S\", \"B\"]",
   "\"live_capture.py\" = [\"S603\", \"S404\", \"S607\"]   # argv-only subprocess with resolved executable, reviewed",
   "\"tools/compare_engine.py\" = [\"S603\"]        # sys.executable with argv-only arguments, reviewed",
   "\"tools/check_pin_drift.py\" = [\"S603\"]       # resolved git executable with argv-only arguments, reviewed",
   "\"tools/check_release_exposure.py\" = [\"S603\"]   # resolved git executable with argv-only arguments, reviewed",
   "\"tools/check_workflow_policy.py\" = [\"S603\"]    # resolved git executable with argv-only arguments, reviewed",
   "\"tools/build_manifest.py\" = [\"S603\", \"S607\"]  # fixed argv `git rev-parse` for manifest provenance only",
   "\"live_smoke.py\" = [\"S603\", \"S404\", \"S607\", \"S104\"]",
   "\"*interop*.py\" = [\"S603\", \"S404\", \"S607\"]",
   "\"benchmark*.py\" = [\"S603\", \"S404\", \"S607\"]",
   "\"ike_decoder_check.py\" = [\"S603\", \"S404\", \"S607\"]",
   "# Presentation application (stage 1a): argv-only subprocess calls, no shell. The workers run sys.executable on the",
   "# app's own scripts; tcpdump comes from live_capture.capture_command, which validates interface and filter.",
   "\"presentation/server.py\" = [\"S603\"]",
   "\"presentation/live_manager.py\" = [\"S603\"]",
   "\"presentation/poc_decryption/live.py\" = [\"S603\"]",
   "\"presentation/launch.py\" = [\"S603\", \"S310\"]   # S310: urlopen only of http://127.0.0.1:<port> built in main()"
  ],
  "bandit.yaml": [
   "# Bandit configuration (SSDLC static analysis gate).",
   "#",
   "# Accepted findings, reviewed against THREAT-MODEL.md T8 and SR-12:",
   "#   B404 import subprocess, B603 subprocess call without shell \u2014 live_capture.py",
   "#   starts tcpdump with an argv list only (no shell), a resolved executable path,",
   "#   a validated interface name and a filter that is passed as one argument.",
   "#   test_live.test_command_arguments_are_not_shell_code verifies this.",
   "skips: [\"B404\", \"B603\"]",
   "exclude_dirs:",
   "  - tests",
   "  - .git",
   "assert_used:",
   "  skips: [\"*test_*.py\"]"
  ],
  ".gitleaks.toml": [
   "# gitleaks configuration (SSDLC.md): extend the default rules, allow documented protocol test vectors.",
   "title = \"protocol-detector\"",
   "",
   "[extend]",
   "useDefault = true",
   "",
   "[allowlist]",
   "description = \"Published protocol test vectors are not credentials\"",
   "paths = [",
   "  '''protocol_fixtures\\.py''',",
   "  '''test_[a-z0-9_]+\\.py''',",
   "]",
   "regexes = [",
   "  # RFC 6455 section 1.3 WebSocket example nonce/accept and RFC 9001/9369 QUIC vectors reproduced in fixtures.",
   "  '''Sec-WebSocket-(Key|Accept)''',",
   "  # The SSH post-quantum key exchange name in the PROTOCOLS.md v0.58 table (\"key exchange names:",
   "  # sntrup761x25519\") matches generic-api-key; exact token only, so a real key next to it still flags.",
   "  '''^sntrup761x25519$''',",
   "  # research/live-results-2026-11-21-r5.tsv line 8 (claude/app-research 75695d3, PRO-135/PRO-145): the public DNS",
   "  # CNAME chain \"sdds3.sophosupd.com.edgekey.net>e3113.dscd.akamaiedge.net\" reads as key=value to generic-api-key",
   "  # (\"edgekey\" + \">\"). Exact public hostname only, so any real secret elsewhere still flags.",
   "  '''^e3113\\.dscd\\.akamaiedge\\.net$''',",
   "  # Go table tests carry synthetic HTTP/1 messages as hex (go/internal/protocols/textroute/boundary_test.go on",
   "  # claude/mutation-gremlins 296227b, PRO-126); a case name ending in \"key ...\" or \"tokens\" next to the hex reads",
   "  # as key=value to generic-api-key. Only an all-hex value that decodes to an HTTP/1 start line (\"GET \", \"POST \",",
   "  # \"HTTP/1.\") is allowed, so a hex or base64 secret that is not an HTTP message still flags.",
   "  '''^(?:47455420|504f535420|485454502f312e)(?:[0-9a-f]{2})+$''',",
   "]",
   "",
   "# Stage 8 (A16/A10): an NSS key log (SSLKEYLOGFILE) must never be committed. Secrets and client randoms are",
   "# 32 or 48 bytes of hex; placeholder vectors in tests are all-zero or repeated bytes and are allowlisted by",
   "# the paths above only when they are such placeholders (tools/check_no_keylogs.py enforces that part).",
   "[[rules]]",
   "id = \"nss-key-log\"",
   "description = \"TLS key-log line (CLIENT_RANDOM / TRAFFIC_SECRET with hex secrets)\"",
   "regex = '''(?m)^(CLIENT_RANDOM|(?:CLIENT|SERVER)_(?:HANDSHAKE_)?TRAFFIC_SECRET_?0?|EXPORTER_SECRET)\\s+[0-9a-fA-F]{64}\\s+[0-9a-fA-F]{64,96}\\s*$'''",
   "keywords = [\"CLIENT_RANDOM\", \"TRAFFIC_SECRET\", \"EXPORTER_SECRET\"]"
  ],
