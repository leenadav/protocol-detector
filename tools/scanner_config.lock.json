{
 "files": {
  "pyproject.toml": [
   "[tool.ruff]",
   "line-length = 160",
   "target-version = \"py39\"",
   "",
   "[tool.ruff.lint]",
   "# Correctness and security rules only; style is not a CI gate.",
   "select = [\"E9\", \"F\", \"B\", \"S\", \"PLE\", \"W605\", \"PGH004\"]   # PGH004: a noqa must name its rule",
   "ignore = [",
   "  \"B011\",  # assert False in tests is deliberate",
   "  \"S101\",  # asserts are test code",
   "  \"S311\",  # random is used for seeded fuzzing, never for secrets",
   "  \"B904\",  # explicit `raise ... from None` is used where chaining would leak",
   "  \"B905\",  # zip(strict=) is Python 3.10+",
   "  \"B007\",  # historical benchmark scripts keep their loop variables",
   "]",
   "",
   "[tool.ruff.lint.per-file-ignores]",
   "\"test_*.py\" = [\"S\", \"B\"]",
   "\"live_capture.py\" = [\"S603\", \"S404\", \"S607\"]   # argv-only subprocess with resolved executable, reviewed",
   "\"tools/compare_engine.py\" = [\"S603\"]        # sys.executable with argv-only arguments, reviewed",
   "\"tools/check_pin_drift.py\" = [\"S603\"]       # resolved git executable with argv-only arguments, reviewed",
   "\"tools/check_release_exposure.py\" = [\"S603\"]   # resolved git executable with argv-only arguments, reviewed",
   "\"tools/check_workflow_policy.py\" = [\"S603\"]    # resolved git executable with argv-only arguments, reviewed",
   "\"live_smoke.py\" = [\"S603\", \"S404\", \"S607\", \"S104\"]",
   "\"*interop*.py\" = [\"S603\", \"S404\", \"S607\"]",
   "\"benchmark*.py\" = [\"S603\", \"S404\", \"S607\"]",
   "\"ike_decoder_check.py\" = [\"S603\", \"S404\", \"S607\"]"
  ],
  "bandit.yaml": [
   "# Bandit configuration (SSDLC static analysis gate).",
   "#",
   "# Accepted findings, reviewed against THREAT-MODEL.md T8 and SR-12:",
   "#   B404 import subprocess, B603 subprocess call without shell \u2014 live_capture.py",
   "#   starts tcpdump with an argv list only (no shell), a resolved executable path,",
   "#   a validated interface name and a filter that is passed as one argument.",
   "#   test_live.test_command_arguments_are_not_shell_code verifies this.",
   "skips: [\"B404\", \"B603\"]",
   "exclude_dirs:",
   "  - tests",
   "  - .git",
   "assert_used:",
   "  skips: [\"*test_*.py\"]"
  ],
  ".gitleaks.toml": [
   "# gitleaks configuration (SSDLC.md): extend the default rules, allow documented protocol test vectors.",
   "title = \"protocol-detector\"",
   "",
   "[extend]",
   "useDefault = true",
   "",
   "[allowlist]",
   "description = \"Published protocol test vectors are not credentials\"",
   "paths = [",
   "  '''protocol_fixtures\\.py''',",
   "  '''test_[a-z0-9_]+\\.py''',",
   "]",
   "regexes = [",
   "  # RFC 6455 section 1.3 WebSocket example nonce/accept and RFC 9001/9369 QUIC vectors reproduced in fixtures.",
   "  '''Sec-WebSocket-(Key|Accept)''',",
   "  # PROTOCOLS.md names SSH key exchange methods; this public algorithm identifier is not a credential.",
   "  '''^sntrup761x25519$''',",
   "]"
  ],
