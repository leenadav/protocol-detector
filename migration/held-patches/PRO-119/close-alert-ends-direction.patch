+// PRO-119 (second A2 run): after its sender's authenticated close_notify or fatal alert a direction decodes
+// nothing more. A valid record after the alert releases no plaintext and is not counted as authenticated, and a
+// modified one does not fail the connection. TLS 1.3 user_canceled does not close. A Go-only divergence: the
+// reference (poc_decryption.engine) keeps decoding.
+func TestRecordsAfterAClosingAlertAreNotDecoded(t *testing.T) {
+	type variant struct {
+		name   string
+		alert  []byte
+		closes bool
+	}
+	for _, v := range []variant{{"close_notify", []byte{1, 0}, true}, {"fatal at warning level", []byte{1, 40}, true},
+		{"fatal", []byte{2, 20}, true}, {"user_canceled", []byte{1, 90}, false}} {
+		s := tls13Session(0x1301)
+		sw := newWriter13(0x1301, bytes.Repeat([]byte{2}, 32), bytes.Repeat([]byte{4}, 32))
+		sw.application()
+		sw.seq = 1 // the session wrote the reply at 0 ...
+		server := s.server[:len(s.server)-(5+3+16)]
+		server = append(server, sw.record(21, v.alert)...) // ... and this alert at 1
+		late := sw.record(23, []byte("after the alert"))
+		for _, tamper := range []bool{false, true} {
+			tail := append([]byte{}, late...)
+			if tamper {
+				tail[len(tail)-1] ^= 1
+			}
+			keys, _ := ReadKeys(s.keylog)
+			c := NewConnection(keys, "c", "s")
+			c.Feed("c", s.client)
+			c.Feed("s", append(append([]byte{}, server...), tail...))
+			var reply []byte
+			for c.HasWork() {
+				for _, d := range c.Advance(64) {
+					if d.Endpoint == "s" {
+						reply = append(reply, d.Data...)
+					}
+				}
+			}
+			state := c.Finish()
+			switch {
+			case v.closes && (state != StateComplete || string(reply) != string(s.reply) || c.RecordsAuthenticated != 8):
+				t.Errorf("%s tamper=%v: %s %s, reply %q, %d authenticated", v.name, tamper, state, c.Reason, reply, c.RecordsAuthenticated)
+			case !v.closes && !tamper && (state != StateComplete || string(reply) != string(s.reply)+"after the alert"):
+				t.Errorf("%s: %s, reply %q", v.name, state, reply)
+			case !v.closes && tamper && c.ReasonCode != AuthenticationFailed:
+				t.Errorf("%s tamper: %s %s", v.name, state, c.ReasonCode)
+			}
+		}
+	}
+
+	// TLS 1.2: a close_notify ends the client's direction; a warning alert other than close_notify does not.
+	for _, tc := range []struct {
+		alert  []byte
+		closes bool
+	}{{[]byte{1, 0}, true}, {[]byte{2, 10}, true}, {[]byte{1, 100}, false}} {
+		t12 := tls12SessionWith(tc.alert, []byte("after the alert"))
+		keys, _ := ReadKeys(t12.keylog)
+		c := NewConnection(keys, "c", "s")
+		c.Feed("c", t12.client)
+		c.Feed("s", t12.server)
+		var request []byte
+		for c.HasWork() {
+			for _, d := range c.Advance(64) {
+				if d.Endpoint == "c" {
+					request = append(request, d.Data...)
+				}
+			}
+		}
+		want := string(t12.request)
+		if !tc.closes {
+			want += "after the alert"
+		}
+		if c.Finish() != StateComplete || string(request) != want {
+			t.Errorf("TLS 1.2 alert %v: %s %s, request %q", tc.alert, c.State, c.Reason, request)
+		}
+	}
+}
