+// closingAlert reports whether an authenticated two-byte alert ends its sender's direction. TLS 1.3 (RFC 8446
+// section 6) treats every alert except user_canceled (90) as closure or error whatever its level; TLS 1.2 (RFC
+// 5246 section 7.2) ends the direction on close_notify (0) or a fatal level (2).
+func closingAlert(alert []byte, tls13 bool) bool {
+	if tls13 {
+		return alert[1] != 90
+	}
+	return alert[1] == 0 || alert[0] == 2
+}
