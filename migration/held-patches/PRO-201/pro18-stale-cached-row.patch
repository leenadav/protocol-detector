+// A report cached while a connection waits for its secrets is rebuilt when a later key-log line makes the
+// first record fail authentication, though that work produced no plaintext (Codex PRO-18 P2).
+func TestAReportCachedWhileAwaitingKeysSeesALaterAuthenticationFailure(t *testing.T) {
+	pack, err := content.Embedded()
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner, err := newCoordinator(pack, Budget{PerDirection: decrypt.MaxStream, Aggregate: 4 * 1024 * 1024, Connections: MaxConnections, Pending: 8192}, MaxConnections)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keys := decrypt.NewKeyProvider()
+	defer keys.Release()
+	d := newDecryptor(pack, owner.Tier, keys)
+	client, server, keylog := exchange()
+	for i, f := range conversation(client, server) {
+		packet, err := transport.Decode(f, 1, transport.Ignore)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := owner.accept(packet.(*transport.TCP), 1700000000+float64(i)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := d.pump(); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.work(256, 64); err != nil {
+		t.Fatal(err)
+	}
+	if text := d.report(0, 0, ""); !strings.Contains(text, `"reason_code": "awaiting_keys"`) {
+		t.Fatalf("before the keys: %s", text)
+	}
+	wrong := strings.ReplaceAll(keylog, strings.Repeat("01", 32), strings.Repeat("ee", 32))
+	if _, err := keys.Append(wrong); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.work(256, 64); err != nil {
+		t.Fatal(err)
+	}
+	if text := d.report(0, 0, ""); !strings.Contains(text, `"reason_code": "authentication_failed"`) {
+		t.Fatalf("after a wrong secret: %s", text)
+	}
+}
