+// A connection past the retained tier's cap is never silently left out: the run stops with the budget code,
+// as the offline decrypt-capture refuses it (Codex PRO-18 P2).
+func TestAConnectionPastTheCapIsABudgetFailure(t *testing.T) {
+	var frames [][]byte
+	for i := 0; i <= MaxConnections; i++ {
+		syn := frame(true, 999, 0, 2, "")
+		binary.BigEndian.PutUint16(syn[34:], uint16(20000+i))
+		frames = append(frames, syn)
+	}
+	status, events, text := replay(t, append(op('P', 100, stream(frames...)), op('E', 101, nil)...))
+	last := events[len(events)-1]
+	if status != 1 || last["type"] != "error" || last["code"] != "budget" {
+		t.Fatalf("status %d, events %s\n%s", status, kinds(events), text)
+	}
+}
