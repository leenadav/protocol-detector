+// A failed decryption names no inner protocol: plaintext fed through the merged outer inspector before a
+// later record failed must not reach the failure row's layers (Codex PRO-18 P2). Work runs after every
+// frame, as in the live worker, so the request's plaintext is delivered before the response fails.
+func TestAFailedDecryptionNamesNoInnerProtocol(t *testing.T) {
+	pack, err := content.Embedded()
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner, err := newCoordinator(pack, Budget{PerDirection: decrypt.MaxStream, Aggregate: 4 * 1024 * 1024, Connections: MaxConnections, Pending: 8192}, MaxConnections)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keys := decrypt.NewKeyProvider()
+	defer keys.Release()
+	client, server, keylog := exchange()
+	if _, err := keys.Append(keylog); err != nil {
+		t.Fatal(err)
+	}
+	server = append([]byte{}, server...)
+	server[len(server)-1] ^= 1 // the server's application record fails authentication
+	d := newDecryptor(pack, owner.Tier, keys)
+	for i, f := range conversation(client, server) {
+		packet, err := transport.Decode(f, 1, transport.Ignore)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := owner.accept(packet.(*transport.TCP), 1700000000+float64(i)); err != nil {
+			t.Fatal(err)
+		}
+		if err := d.pump(); err != nil {
+			t.Fatal(err)
+		}
+		if err := d.work(1, 1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := owner.end("Capture input EOF"); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.pump(); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.work(1<<20, 1); err != nil {
+		t.Fatal(err)
+	}
+	var out report
+	text := d.report(0, 0, "")
+	if err := json.Unmarshal([]byte(text), &out); err != nil {
+		t.Fatal(err)
+	}
+	if len(out.Connections) != 1 || out.Connections[0]["reason_code"] != "authentication_failed" || out.Connections[0]["authenticated_records"] == float64(0) {
+		t.Fatalf("report: %s", text)
+	}
+	if inner := out.Connections[0]["layers"].(map[string]interface{})["inner"]; inner != nil {
+		t.Fatalf("a failed decryption carries an inner view: %v", inner)
+	}
+}
