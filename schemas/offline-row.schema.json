{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://protocol-detector/schemas/offline-row.schema.json",
  "title": "Offline analysis row",
  "description": "One JSON Lines row of analyze_pcap.py --json / protodetect analyze --json.",
  "oneOf": [
    {
      "$ref": "#/$defs/frame_row"
    },
    {
      "$ref": "#/$defs/skipped"
    },
    {
      "$ref": "#/$defs/stream_end"
    },
    {
      "$ref": "#/$defs/capture_gap"
    },
    {
      "$ref": "#/$defs/session"
    },
    {
      "$ref": "#/$defs/offline_summary"
    }
  ],
  "$defs": {
    "endpoint": {
      "type": "array",
      "items": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value",
        "source",
        "strength"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "strength": {
          "enum": [
            "structural",
            "asserted",
            "offered",
            "derived",
            "heuristic",
            "configured_mapping",
            "configured_signature",
            "context"
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "transport",
        "encryption",
        "application_protocol",
        "application",
        "hostname",
        "offered_alpn",
        "evidence",
        "reason",
        "scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "detecting",
            "identified",
            "unknown",
            "malformed",
            "incomplete",
            "budget_exhausted",
            "invalidated"
          ]
        },
        "transport": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "encryption": {
          "type": [
            "string",
            "null"
          ]
        },
        "application_protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "application": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "offered_alpn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "kind",
        "observation"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "updated",
            "refined",
            "shifted",
            "invalidated",
            "datagram"
          ]
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      }
    },
    "counter": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "rule",
        "reasons"
      ],
      "properties": {
        "action": {
          "enum": [
            "allow",
            "deny",
            "alert"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "predicates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity_basis",
            "activity",
            "affiliation",
            "decryption",
            "capture_quality",
            "engine_status",
            "directions",
            "observation"
          ],
          "properties": {
            "identity_basis": {
              "enum": [
                "authenticated_plaintext",
                "structural",
                "configured_rule",
                "client_assertion",
                "none"
              ]
            },
            "activity": {
              "enum": [
                "unobserved",
                "http-request",
                "authenticated-plaintext",
                "none"
              ]
            },
            "affiliation": {
              "enum": [
                "service",
                "provider-web",
                "none"
              ]
            },
            "decryption": {
              "enum": [
                "none",
                "awaiting_hello",
                "awaiting_keys",
                "decrypting",
                "complete",
                "failed"
              ]
            },
            "capture_quality": {
              "enum": [
                "intact",
                "degraded",
                "provisional"
              ]
            },
            "engine_status": {
              "type": "string"
            },
            "directions": {
              "enum": [
                "consistent",
                "conflicting",
                "one-direction"
              ]
            },
            "observation": {
              "enum": [
                "handshake",
                "asymmetric",
                "midstream",
                "datagram"
              ]
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "session"
        },
        "transport": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "client": {
          "$ref": "#/$defs/endpoint"
        },
        "server": {
          "$ref": "#/$defs/endpoint"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "packets": {
          "type": "integer",
          "minimum": 0
        },
        "client_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "server_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "end_reason": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "subcategory": {
          "type": "string"
        },
        "technology": {
          "type": "string"
        },
        "risk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "characteristics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base_app": {
          "type": [
            "string",
            "null"
          ]
        },
        "implicitly_uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "port_usage": {
          "enum": [
            "standard",
            "nonstandard",
            "unknown"
          ]
        },
        "engine_status": {
          "type": "string"
        },
        "client_protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "server_protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "encryption": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shifted_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chain": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "self_issued": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            },
            "lifetime_days": {
              "type": "string"
            },
            "not_before": {
              "type": "string"
            },
            "not_after": {
              "type": "string"
            },
            "ca": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "eku": {
              "type": "string",
              "enum": [
                "server-auth",
                "any",
                "other",
                "absent"
              ]
            },
            "san": {
              "type": "string",
              "enum": [
                "present",
                "absent"
              ]
            },
            "validity": {
              "type": "string",
              "enum": [
                "current",
                "expired",
                "not-yet-valid"
              ]
            }
          }
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "layers": {
          "$ref": "#/$defs/layers"
        },
        "signature_set": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "description": "Stage 7: digest of the custom signature set this verdict was classified with."
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_seconds",
            "stable_seconds"
          ],
          "properties": {
            "first_seconds": {
              "type": "number",
              "minimum": 0
            },
            "stable_seconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "Seconds from the first packet to the first identification and to the last label change (decision latency, not lifetime)."
        },
        "attribution": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "provider",
            "kind",
            "family",
            "activity",
            "asserted_by"
          ],
          "properties": {
            "provider": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "service",
                "provider-web"
              ]
            },
            "family": {
              "type": "string"
            },
            "activity": {
              "enum": [
                "unobserved",
                "http-request",
                "authenticated-plaintext"
              ]
            },
            "asserted_by": {
              "const": "client-server-name"
            }
          },
          "description": "D03: provider affiliation from the client-asserted server name, the provider's application family, and the activity actually observed; affiliation is never activity or identity."
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "handshake_observed",
            "directions_seen",
            "roles"
          ],
          "properties": {
            "mode": {
              "enum": [
                "handshake",
                "asymmetric",
                "midstream",
                "datagram"
              ]
            },
            "handshake_observed": {
              "type": "boolean"
            },
            "directions_seen": {
              "type": "array",
              "items": {
                "enum": [
                  "client",
                  "server"
                ]
              }
            },
            "roles": {
              "enum": [
                "observed",
                "assumed-from-first-segment"
              ]
            }
          },
          "description": "D05: how the connection was observed; identifications made midstream or on one side only are marked, never silently equal to a handshake observation."
        },
        "input_quality": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "D06: rejected or suspect packets of this flow by kind; the flow was not fully inspected."
        }
      },
      "required": [
        "type",
        "transport",
        "client",
        "server",
        "start",
        "end",
        "packets",
        "client_bytes",
        "server_bytes",
        "end_reason",
        "app",
        "category",
        "subcategory",
        "technology",
        "risk",
        "characteristics",
        "base_app",
        "implicitly_uses",
        "port_usage",
        "engine_status",
        "client_protocol",
        "server_protocol",
        "encryption",
        "reasons",
        "shifted_from",
        "risks"
      ]
    },
    "frame_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "source",
        "destination",
        "message",
        "classification",
        "events"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "destination": {
          "$ref": "#/$defs/endpoint"
        },
        "message": {
          "type": "string"
        },
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "app": {
          "type": "string"
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "status",
        "reason"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "skipped"
        },
        "reason": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "link",
            "network",
            "fragment",
            "length",
            "transport",
            "truncated",
            "checksum",
            "malformed"
          ]
        }
      }
    },
    "stream_end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "destination",
        "classification",
        "events"
      ],
      "properties": {
        "type": {
          "const": "stream_end"
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "destination": {
          "$ref": "#/$defs/endpoint"
        },
        "classification": {
          "$ref": "#/$defs/observation"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "capture_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "active_connections",
        "scope",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "capture_gap"
        },
        "active_connections": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "frame": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "offline_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/counter"
        },
        "input_quality": {
          "$ref": "#/$defs/input_quality"
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "transport",
        "outer",
        "encryption",
        "inner",
        "application",
        "decryption",
        "capture_quality",
        "chain",
        "claims"
      ],
      "description": "Stage 5 (A05/A13): per-layer knowledge and the effective application with its identity basis; labels only.",
      "properties": {
        "version": {
          "const": 1
        },
        "transport": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "outer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "app",
            "status"
          ],
          "properties": {
            "protocol": {
              "type": [
                "string",
                "null"
              ]
            },
            "app": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        },
        "encryption": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "protocol",
            "offered_alpn",
            "server_name_asserted",
            "version"
          ],
          "properties": {
            "protocol": {
              "type": "string"
            },
            "offered_alpn": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "server_name_asserted": {
              "type": "boolean"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "inner": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "protocol",
            "app",
            "status",
            "source",
            "authenticated"
          ],
          "properties": {
            "protocol": {
              "type": [
                "string",
                "null"
              ]
            },
            "app": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "source": {
              "const": "decrypted"
            },
            "authenticated": {
              "type": "boolean"
            }
          }
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "category",
            "status",
            "basis",
            "provider",
            "affiliation",
            "activity"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "basis": {
              "enum": [
                "authenticated_plaintext",
                "structural",
                "configured_rule",
                "client_assertion",
                "none"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "affiliation": {
              "enum": [
                "service",
                "provider-web",
                null
              ]
            },
            "activity": {
              "enum": [
                "unobserved",
                "http-request",
                "authenticated-plaintext",
                null
              ]
            }
          }
        },
        "decryption": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "authenticated_records": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "capture_quality": {
          "type": "string"
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "source",
              "strength"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "strength": {
                "enum": [
                  "asserted",
                  "offered",
                  "derived"
                ]
              }
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "input_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "checksums",
        "rejected",
        "flows_marked",
        "unsupported",
        "checksums_note"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "recorded",
            "host",
            "reassembled"
          ]
        },
        "checksums": {
          "enum": [
            "ignore",
            "audit",
            "verify"
          ]
        },
        "rejected": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "flows_marked": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checksums_note": {
          "type": "string"
        }
      }
    }
  }
}
