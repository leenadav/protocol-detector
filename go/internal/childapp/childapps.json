{
 "schema": 1,
 "release": {
  "version": "2026.11.0",
  "note": "PRO-492 seed: child applications per function for gmail, google-drive, dropbox, slack, github, box and discord, from their official API references",
  "review": "engine-lane self-review; Hermes review stage on the PRO-492 pull request"
 },
 "children": [
  {
   "name": "gmail-uploading",
   "container": "gmail",
   "description": "Gmail API media upload of a message or draft with attachments",
   "characteristics": ["widely-used", "transfers-files"],
   "depends_on": ["google-base"],
   "evidence": ["https://developers.google.com/workspace/gmail/api/guides/uploads"],
   "rules": [
    {"hosts": ["gmail.googleapis.com", "www.googleapis.com"], "methods": ["POST", "PUT"], "path_prefixes": ["/upload/gmail/v1/users/"]}
   ]
  },
  {
   "name": "gmail-sending",
   "container": "gmail",
   "description": "Gmail API message or draft send",
   "depends_on": ["google-base"],
   "evidence": ["https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.messages/send",
                "https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.drafts/send"],
   "rules": [
    {"hosts": ["gmail.googleapis.com", "www.googleapis.com"], "methods": ["POST"],
     "path_patterns": ["/gmail/v1/users/*/messages/send", "/gmail/v1/users/*/drafts/send"]}
   ]
  },
  {
   "name": "gmail-downloading",
   "container": "gmail",
   "description": "Gmail API attachment download",
   "characteristics": ["widely-used", "transfers-files"],
   "depends_on": ["google-base"],
   "evidence": ["https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.messages.attachments/get"],
   "rules": [
    {"hosts": ["gmail.googleapis.com", "www.googleapis.com"], "methods": ["GET"],
     "path_patterns": ["/gmail/v1/users/*/messages/*/attachments/*"]}
   ]
  },
  {
   "name": "google-drive-uploading",
   "container": "google-drive",
   "description": "Google Drive API file upload (simple, multipart or resumable)",
   "depends_on": ["google-base"],
   "evidence": ["https://developers.google.com/workspace/drive/api/guides/manage-uploads"],
   "rules": [
    {"hosts": ["www.googleapis.com"], "methods": ["POST", "PATCH", "PUT"], "path_prefixes": ["/upload/drive/v3/files"]}
   ]
  },
  {
   "name": "google-drive-downloading",
   "container": "google-drive",
   "description": "Google Drive API export of a Google Workspace document",
   "depends_on": ["google-base"],
   "evidence": ["https://developers.google.com/workspace/drive/api/reference/rest/v3/files/export"],
   "rules": [
    {"hosts": ["www.googleapis.com"], "methods": ["GET"], "path_patterns": ["/drive/v3/files/*/export"]}
   ]
  },
  {
   "name": "dropbox-uploading",
   "container": "dropbox",
   "description": "Dropbox API file upload, including upload sessions",
   "evidence": ["https://www.dropbox.com/developers/documentation/http/documentation"],
   "rules": [
    {"hosts": ["content.dropboxapi.com"], "methods": ["POST"], "path_prefixes": ["/2/files/upload"]}
   ]
  },
  {
   "name": "dropbox-downloading",
   "container": "dropbox",
   "description": "Dropbox API file and folder download",
   "evidence": ["https://www.dropbox.com/developers/documentation/http/documentation"],
   "rules": [
    {"hosts": ["content.dropboxapi.com"], "methods": ["POST", "GET"], "path_prefixes": ["/2/files/download"]}
   ]
  },
  {
   "name": "dropbox-sharing",
   "container": "dropbox",
   "description": "Dropbox API sharing of files, folders and links",
   "evidence": ["https://www.dropbox.com/developers/documentation/http/documentation"],
   "rules": [
    {"hosts": ["api.dropboxapi.com"], "methods": ["POST"], "path_prefixes": ["/2/sharing/"]}
   ]
  },
  {
   "name": "slack-file-transfer",
   "container": "slack",
   "description": "Slack Web API external file upload",
   "evidence": ["https://api.slack.com/methods/files.getUploadURLExternal",
                "https://api.slack.com/methods/files.completeUploadExternal"],
   "rules": [
    {"hosts": ["slack.com"], "methods": ["POST", "GET"],
     "path_patterns": ["/api/files.getUploadURLExternal", "/api/files.completeUploadExternal"]}
   ]
  },
  {
   "name": "slack-posting",
   "container": "slack",
   "description": "Slack Web API message post",
   "evidence": ["https://api.slack.com/methods/chat.postMessage"],
   "rules": [
    {"hosts": ["slack.com"], "methods": ["POST"], "path_patterns": ["/api/chat.postMessage"]}
   ]
  },
  {
   "name": "github-uploading",
   "container": "github",
   "description": "GitHub REST API release asset upload",
   "evidence": ["https://docs.github.com/en/rest/releases/assets"],
   "rules": [
    {"hosts": ["uploads.github.com"], "methods": ["POST"], "path_patterns": ["/repos/*/*/releases/*/assets"]}
   ]
  },
  {
   "name": "box-uploading",
   "container": "box",
   "description": "Box API file upload and new file version upload",
   "evidence": ["https://developer.box.com/reference/post-files-content/",
                "https://developer.box.com/reference/post-files-id-content/"],
   "rules": [
    {"hosts": ["upload.box.com"], "methods": ["POST"],
     "path_patterns": ["/api/2.0/files/content", "/api/2.0/files/*/content"]}
   ]
  },
  {
   "name": "box-downloading",
   "container": "box",
   "description": "Box API file download",
   "evidence": ["https://developer.box.com/reference/get-files-id-content/"],
   "rules": [
    {"hosts": ["api.box.com"], "methods": ["GET"], "path_patterns": ["/2.0/files/*/content"]}
   ]
  },
  {
   "name": "discord-gateway",
   "container": "discord",
   "description": "Discord Gateway real-time WebSocket session",
   "evidence": ["https://discord.com/developers/docs/events/gateway"],
   "rules": [
    {"hosts": ["gateway.discord.gg"], "websocket": true}
   ]
  }
 ]
}
